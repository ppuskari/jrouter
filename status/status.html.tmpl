{{- define "render_items" -}}
    {{- range $title, $item := . -}}
    <details open>
        <summary>{{$title}}</summary>
        <div class="itemdata">{{$item.Eval $.Ctx}}</div>
        <div class="subitems">{{template "render_items" $item.Items}}</div>
    </details>
    {{- end -}}
{{- end -}}
<!DOCTYPE html>
<html>
<head>
    <title>{{.PageName}} for {{.ExeName}}</title>
    <style>
    :root {
        color-scheme: light dark;
    }
    body {
        font-family: sans-serif;
        background: light-dark(#fff, #111);
    }
    nav {
        text-align: center;
        margin: 0.4em 0 0.8em 0;
    }
    nav a {
        margin: 0 0.6em;
    }
    h1 {
        clear: both;
        width: 100%;
        text-align: center;
        font-size: 120%;
        background: {{if .March}}linear-gradient(
                to bottom,
                /* #5EBD3E */ light-dark(#bee5b1,#264c19) 16%,
                /* #FFB900 */ light-dark(#ffe399,#664a00) 16% 33%,
                /* #F78200 */ light-dark(#ffcd96,#633400) 33% 50%,
                /* #E23838 */ light-dark(#f3afaf,#620e0e) 50% 67%,
                /* #973999 */ light-dark(#dda8de,#3c173d) 67% 83%,
                /* #009CDF */ light-dark(#8cddff,#003e59) 83%
            );{{else}}light-dark(#eef, #334);{{end}}
        padding: 4px 0;
    }
    summary {
        width: 100%;
        font-size: 120%;
        background: light-dark(#eef, #334);
        padding: 0.2em 0;
        border: 1px #eef solid;
    }
    details {
        display: block;
        padding: 1em 0;
    }
    details[open] > summary {
        background: light-dark(#fff, #111);
        border: 1px #000 solid;
    }
    .error {
        background: light-dark(#fee, #311);
    }
    div {
        padding: 0.2em;
    }
    div.summary {
        display: flex;
    }
    div.summary div.grow {
        flex-grow: 1;
    }
    div.summary div.shrink {
        flex-shrink: 1;
    }
    div.summary div.shrink img {
        max-width: 200px;
        max-height: 128px;
    }
    div.warning {
        background: light-dark(#ffd, #331);
    }
    table {
        border-collapse: collapse;
        border-style: solid none;
        border-width: 2px;
    }
    table thead {
        text-align: left;
    }
    table thead tr th {
        border-bottom: 1px solid;
    }
    table.sortable thead th {
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }
    table.sortable thead th::after {
        content: " ↕";
        opacity: 0.35;
        font-size: 85%;
    }
    table.sortable thead th[aria-sort="ascending"]::after {
        content: " ▲";
        opacity: 1;
    }
    table.sortable thead th[aria-sort="descending"]::after {
        content: " ▼";
        opacity: 1;
    }
    tr:nth-child(even) {
        background-color: light-dark(#eee, #333);
    }
    td,
    th {
        padding: 2px 8px;
    }
    .itemdata {
        margin: 0 0 0.5em 0.86em;
        padding: 0.5em 0em 0.5em 1.5em;
        border-left: 0.1em light-dark(#ccc, #333) dotted;
    }
    .subitems {
        margin: 0 0 0.5em 0.86em;
        padding: 0.5em 0em 0.5em 1.5em;
        border-left: 0.1em light-dark(#ccc, #333) dotted;
        border-bottom: 0.1em light-dark(#ccc, #333) dotted;
    }
    ul {
        margin: 0;
    }
    .green {
        color: light-dark(#070, #1f1);
    }
    .red {
        color: light-dark(#811, #f11);
    }
    </style>
</head>
<body>
    <h1>{{.PageName}} for {{.ExeName}}</h1>
    <nav><a href="/status">Status</a><a href="/peering">Peering</a></nav>
    <div class="summary">
        <div class="grow">
            {{.ExePath}}<br>
            Started at {{.StartTime}} ({{.StartTimeAgo}} ago)<br>
            Current time {{.CurrentTime}}<br>
            Version {{.Version}}, build {{.Build}}<br>
            Running in PID {{.PID}} as {{.Username}} on {{.Hostname}}<br>
            {{.RuntimeVer}} on {{.GOOS}}/{{.GOARCH}} compiled by {{.Compiler}}<br>
            {{.NumGoroutine}} goroutines running/{{.NumCPU}} logical CPUs usable<br>
        </div>
        <div class="shrink">
            {{if .March}}<img src="/MARCHintoshLogo.svg">{{end}}
        </div>
    </div>
    {{range $title := orderedTitles .Items .PageName}}
    {{$item := index $.Items $title}}
    <details open>
        <summary>{{$title}}</summary>
        <div class="itemdata">{{$item.Eval $.Ctx}}</div>
        <div class="subitems">{{template "render_items" $item.Items}}</div>
    </details>
    {{end}}
    <script>
    (() => {
        const collator = new Intl.Collator(undefined, {
            numeric: true,
            sensitivity: "base"
        });

        function durationSeconds(text) {
            const s = text.trim().toLowerCase();
            if (!s.endsWith(" ago")) {
                return null;
            }
            const body = s.slice(0, -4);
            let total = 0;
            let matched = false;
            const units = {
                "ns": 1e-9,
                "us": 1e-6,
                "µs": 1e-6,
                "ms": 1e-3,
                "s": 1,
                "m": 60,
                "h": 3600,
                "d": 86400
            };
            const re = /([0-9]+(?:\.[0-9]+)?)(ns|us|µs|ms|s|m|h|d)/g;
            let m;
            while ((m = re.exec(body)) !== null) {
                total += Number(m[1]) * units[m[2]];
                matched = true;
            }
            return matched ? total : null;
        }

        function sortValue(cell) {
            const text = cell.textContent.trim();
            if (text === "" || text === "-" || text.toLowerCase() === "never") {
                return {kind: 3, value: ""};
            }

            const duration = durationSeconds(text);
            if (duration !== null) {
                return {kind: 0, value: duration};
            }

            if (/^[+-]?[0-9]+(?:\.[0-9]+)?$/.test(text)) {
                return {kind: 0, value: Number(text)};
            }

            const date = Date.parse(text);
            if (!Number.isNaN(date) &&
                /[0-9]{4}|UTC|GMT|T[0-9]{2}:/.test(text)) {
                return {kind: 1, value: date};
            }

            return {kind: 2, value: text};
        }

        function compareValues(a, b) {
            if (a.kind !== b.kind) {
                return a.kind - b.kind;
            }
            if (a.kind === 0 || a.kind === 1) {
                return a.value - b.value;
            }
            return collator.compare(a.value, b.value);
        }

        document.querySelectorAll("table").forEach((table) => {
            const head = table.tHead;
            const body = table.tBodies[0];
            if (!head || !body || head.rows.length === 0) {
                return;
            }

            const headers = Array.from(head.rows[head.rows.length - 1].cells);
            if (headers.length === 0) {
                return;
            }

            table.classList.add("sortable");
            headers.forEach((header, column) => {
                header.tabIndex = 0;
                header.title = "Click to sort";
                header.setAttribute("aria-sort", "none");

                const sort = () => {
                    const descending =
                        header.getAttribute("aria-sort") === "ascending";
                    headers.forEach((h) => h.setAttribute("aria-sort", "none"));
                    header.setAttribute(
                        "aria-sort",
                        descending ? "descending" : "ascending"
                    );

                    const rows = Array.from(body.rows);
                    rows.sort((ra, rb) => {
                        const a = sortValue(ra.cells[column] || ra);
                        const b = sortValue(rb.cells[column] || rb);
                        const cmp = compareValues(a, b);
                        return descending ? -cmp : cmp;
                    });
                    rows.forEach((row) => body.appendChild(row));
                };

                header.addEventListener("click", sort);
                header.addEventListener("keydown", (event) => {
                    if (event.key === "Enter" || event.key === " ") {
                        event.preventDefault();
                        sort();
                    }
                });
            });
        });
    })();
    </script>
</body>
</html>
